{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "blocky",
    "namespace": "blocky",
    "annotations": {
      "metallb.io/loadBalancerIPs": "10.0.0.71"
    }
  },
  "spec": {
    "type": "LoadBalancer",
    "selector": {
      "app": "blocky"
    },
    "ports": [
      {
        "name": "dns",
        "protocol": "UDP",
        "port": 53,
        "targetPort": 53
      },
      {
        "name": "http",
        "protocol": "TCP",
        "port": 4000,
        "targetPort": 4000
      }
    ]
  }
}
