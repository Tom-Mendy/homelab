{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "cinny-secure",
    "namespace": "matrix",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
      "traefik.ingress.kubernetes.io/router.middlewares": "matrix-cinny-route-proof@kubernetescrd"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [
      {
        "host": "chat.tom-mendy.com",
        "http": {
          "paths": [
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "cinny",
                  "port": {
                    "number": 80
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "tls": [
      {
        "hosts": [
          "chat.tom-mendy.com"
        ],
        "secretName": "cinny-tls"
      }
    ]
  }
}
