      "app.kubernetes.io/version": "13.3.0",
      "helm.sh/chart": "grafana-14.3.0",
      "helm.toolkit.fluxcd.io/name": "grafana",
      "helm.toolkit.fluxcd.io/namespace": "flux-system"
    }
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 0,
