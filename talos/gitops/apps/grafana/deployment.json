          "checksum/secret": "c5903444cba52907f6964885d16838bf092b4b41e72bdfd0d2e7bf595d00be27",
          "kubectl.kubernetes.io/default-container": "grafana",
          "kubectl.kubernetes.io/restartedAt": "2026-08-21T22:19:22+02:00"
