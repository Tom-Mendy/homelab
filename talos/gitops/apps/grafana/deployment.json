        "labels": {
          "app.kubernetes.io/instance": "grafana",
          "app.kubernetes.io/name": "grafana",
          "app.kubernetes.io/version": "13.3.0",
          "helm.sh/chart": "grafana-14.3.0"
        }
      },
      "spec": {
