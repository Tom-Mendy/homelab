        "dnsPolicy": "ClusterFirst",
        "enableServiceLinks": true,
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {
          "fsGroup": 472,
          "runAsGroup": 472,
          "runAsNonRoot": true,
          "runAsUser": 472
