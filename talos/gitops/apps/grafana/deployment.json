            "name": "config"
          },
          {
            "configMap": {
              "defaultMode": 420,
              "name": "grafana-dashboards"
            },
            "name": "dashboards-default"
          },
          {
            "name": "storage",
            "persistentVolumeClaim": {
              "claimName": "grafana"
            }
          },
          {
            "emptyDir": {},
            "name": "search"
          }
        ]
