                "name": "GF_SECURITY_ADMIN_USER",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "admin-user",
                    "name": "grafana"
                  }
                }
              },
              {
                "name": "GF_SECURITY_ADMIN_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "admin-password",
                    "name": "grafana"
                  }
                }
              },
              {
                "name": "GF_PATHS_DATA",
