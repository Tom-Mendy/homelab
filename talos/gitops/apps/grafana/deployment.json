              "privileged": false,
              "readOnlyRootFilesystem": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/tmp",
                "name": "tmp"
              },
              {
                "mountPath": "/etc/grafana/grafana.ini",
