{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "grafana",
    "namespace": "grafana"
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "storageClassName": "nfs-k8s",
    "resources": {
      "requests": {
        "storage": "5Gi"
      }
    },
    "volumeName": "grafana-static-pv"
  }
}
