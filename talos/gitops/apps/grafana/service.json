{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "grafana",
    "namespace": "grafana",
    "labels": {
      "app.kubernetes.io/instance": "grafana",
      "app.kubernetes.io/name": "grafana"
    }
  },
  "spec": {
    "ports": [
      {
        "name": "service",
        "port": 80,
        "protocol": "TCP",
        "targetPort": "grafana"
      }
    ],
    "selector": {
      "app.kubernetes.io/instance": "grafana",
      "app.kubernetes.io/name": "grafana"
    },
    "type": "ClusterIP"
  },
  "status": {
    "loadBalancer": {}
  }
}
