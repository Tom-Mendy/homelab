{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "grafana",
    "namespace": "grafana",
    "labels": {
      "app.kubernetes.io/instance": "grafana",
      "app.kubernetes.io/name": "grafana"
    },
    "annotations": {
      "metallb.io/loadBalancerIPs": "10.0.0.72",
      "homelab.tom-mendy.com/temporary": "Internal backend bridge during Grafana migration; remove after the Ubuntu ingress no longer needs it"
    }
  },
  "spec": {
    "ports": [
      {
        "name": "http",
        "port": 3000,
        "protocol": "TCP",
        "targetPort": "grafana"
      }
    ],
    "selector": {
      "app.kubernetes.io/instance": "grafana",
      "app.kubernetes.io/name": "grafana"
    },
    "type": "LoadBalancer"
  },
  "status": {
    "loadBalancer": {}
  }
}
