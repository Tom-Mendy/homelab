{
  "apiVersion": "secrets.infisical.com/v1beta1",
  "kind": "InfisicalStaticSecret",
  "metadata": {
    "name": "qbittorrent-registry-credentials",
    "namespace": "searxng"
  },
  "spec": {
    "infisicalAuthRef": {
      "name": "searxng-infisical",
      "namespace": "searxng"
    },
    "sources": [
      {
        "projectId": "758123bc-7eaa-4256-98a2-bb7438a783b8",
        "environmentSlug": "prod",
        "secretPath": "/harbor/portfolio",
        "recursive": false
      }
    ],
    "targets": [
      {
        "name": "media-harbor-pull",
        "namespace": "qbittorrent",
        "kind": "Secret",
        "creationPolicy": "Orphan",
        "secretType": "kubernetes.io/dockerconfigjson",
        "template": {
          "engineVersion": "v1",
          "data": {
            ".dockerconfigjson": "{{ .HARBOR_PORTFOLIO_DOCKER_CONFIG.Value }}"
          }
        }
      }
    ],
    "syncOptions": {
      "refreshInterval": "1m",
      "instantUpdates": false
    }
  }
}
