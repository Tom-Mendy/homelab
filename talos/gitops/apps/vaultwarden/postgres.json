{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "vaultwarden-postgres-data",
        "namespace": "vaultwarden",
        "labels": { "migration": "talos-vaultwarden" }
      },
      "spec": {
        "accessModes": ["ReadWriteOnce"],
        "resources": { "requests": { "storage": "5Gi" } },
        "storageClassName": "nfs-k8s"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": { "name": "vaultwarden-postgres", "namespace": "vaultwarden" },
      "spec": {
        "type": "ClusterIP",
        "selector": { "app": "vaultwarden-postgres" },
        "ports": [{ "name": "postgres", "port": 5432, "targetPort": 5432, "protocol": "TCP" }]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "vaultwarden-postgres",
        "namespace": "vaultwarden",
        "labels": { "app": "vaultwarden-postgres" }
      },
      "spec": {
        "replicas": 1,
        "strategy": { "type": "Recreate" },
        "selector": { "matchLabels": { "app": "vaultwarden-postgres" } },
        "template": {
          "metadata": { "labels": { "app": "vaultwarden-postgres" } },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": { "seccompProfile": { "type": "RuntimeDefault" } },
            "containers": [{
              "name": "postgres",
              "image": "postgres:16.15@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54",
              "imagePullPolicy": "IfNotPresent",
              "ports": [{ "containerPort": 5432, "name": "postgres", "protocol": "TCP" }],
              "env": [
                { "name": "POSTGRES_DB", "value": "vaultwarden" },
                { "name": "POSTGRES_USER", "value": "vaultwarden" },
                { "name": "POSTGRES_PASSWORD", "valueFrom": { "secretKeyRef": { "name": "vaultwarden-postgres", "key": "POSTGRES_PASSWORD" } } },
                { "name": "PGDATA", "value": "/var/lib/postgresql/data/pgdata" }
              ],
              "startupProbe": {
                "exec": { "command": ["/bin/sh", "-c", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""] },
                "failureThreshold": 30,
                "periodSeconds": 5
              },
              "readinessProbe": {
                "exec": { "command": ["/bin/sh", "-c", "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""] },
                "periodSeconds": 10
              },
              "volumeMounts": [{ "name": "postgres-data", "mountPath": "/var/lib/postgresql/data" }]
            }],
            "volumes": [{ "name": "postgres-data", "persistentVolumeClaim": { "claimName": "vaultwarden-postgres-data" } }]
          }
        }
      }
    }
  ]
}
