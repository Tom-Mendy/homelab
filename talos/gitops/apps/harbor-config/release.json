{
  "apiVersion": "helm.toolkit.fluxcd.io/v2",
  "kind": "HelmRelease",
  "metadata": {
    "name": "harbor-config",
    "namespace": "harbor"
  },
  "spec": {
    "interval": "15m",
    "timeout": "10m",
    "releaseName": "harbor-config",
    "targetNamespace": "harbor",
    "storageNamespace": "harbor",
    "chart": {
      "spec": {
        "chart": "./talos/gitops/apps/harbor-config/chart",
        "reconcileStrategy": "Revision",
        "sourceRef": {
          "kind": "GitRepository",
          "name": "talos-bootstrap",
          "namespace": "flux-system"
        }
      }
    },
    "dependsOn": [
      {
        "name": "harbor",
        "namespace": "harbor"
      }
    ],
    "install": {
      "createNamespace": false,
      "remediation": {
        "retries": 2
      }
    },
    "driftDetection": {
      "mode": "enabled"
    }
  }
}
