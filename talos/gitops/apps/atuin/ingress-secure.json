{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "atuin-secure",
    "namespace": "atuin",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
      "traefik.ingress.kubernetes.io/router.middlewares": "atuin-atuin-route-proof@kubernetescrd"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [{
      "host": "atuin.home.tom-mendy.com",
      "http": { "paths": [{ "path": "/", "pathType": "Prefix", "backend": { "service": { "name": "atuin", "port": { "number": 8888 } } } }] }
    }],
    "tls": [{ "hosts": ["atuin.home.tom-mendy.com"], "secretName": "atuin-tls" }]
  }
}
