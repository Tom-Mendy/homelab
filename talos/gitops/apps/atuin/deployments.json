{
  "apiVersion": "apps/v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres",
        "namespace": "atuin",
        "labels": {
          "app": "postgres"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "postgres",
                "image": "postgres:16.15@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5432,
                    "name": "postgres",
                    "protocol": "TCP"
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "atuin"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "atuin-secrets",
                        "key": "ATUIN_DB_USERNAME"
                      }
                    }
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "atuin-secrets",
                        "key": "ATUIN_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "USER_UID",
                    "value": "1025"
                  },
                  {
                    "name": "USER_GID",
                    "value": "100"
                  }
                ],
                "startupProbe": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 5
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "/bin/sh",
                      "-c",
                      "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "periodSeconds": 10
                },
                "volumeMounts": [
                  {
                    "name": "postgres-data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "postgres-data",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data-v2"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "atuin",
        "namespace": "atuin",
        "labels": {
          "app": "atuin"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "atuin"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "atuin"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "atuin",
                "image": "ghcr.io/atuinsh/atuin:18.24.4@sha256:1cb33a7126b748e0ad6d18d0f52e9bb805a98a196feccd597bf66544f58cf68e",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "start"
                ],
                "ports": [
                  {
                    "containerPort": 8888,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "env": [
                  {
                    "name": "ATUIN_DB_URI",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "atuin-secrets",
                        "key": "ATUIN_DB_URI"
                      }
                    }
                  },
                  {
                    "name": "USER_UID",
                    "value": "1025"
                  },
                  {
                    "name": "USER_GID",
                    "value": "100"
                  },
                  {
                    "name": "ATUIN_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "ATUIN_PORT",
                    "value": "8888"
                  },
                  {
                    "name": "ATUIN_OPEN_REGISTRATION",
                    "value": "false"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 8888
                  },
                  "periodSeconds": 10
                },
                "volumeMounts": [
                  {
                    "name": "atuin-config",
                    "mountPath": "/config"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "atuin-config",
                "persistentVolumeClaim": {
                  "claimName": "atuin-config-v2"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
