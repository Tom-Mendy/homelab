{
  "apiVersion": "traefik.io/v1alpha1",
  "kind": "Middleware",
  "metadata": {
    "name": "qbittorrent-authentik",
    "namespace": "media"
  },
  "spec": {
    "forwardAuth": {
      "address": "https://torrent.tom-mendy.com/outpost.goauthentik.io/auth/traefik",
      "trustForwardHeader": true,
      "authResponseHeaders": [
        "X-authentik-username",
        "X-authentik-groups",
        "X-authentik-email",
        "X-authentik-name",
        "X-authentik-uid"
      ]
    }
  }
}
