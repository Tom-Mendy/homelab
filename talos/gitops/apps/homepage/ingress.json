{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "homepage",
    "namespace": "homepage",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "web",
      "traefik.ingress.kubernetes.io/router.middlewares": "homepage-homepage-route-proof@kubernetescrd"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [
      {
        "host": "homepage.home.tom-mendy.com",
        "http": {
          "paths": [
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "homepage",
                  "port": {
                    "number": 3000
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
