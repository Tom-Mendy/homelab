{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "pushgateway",
    "namespace": "pushgateway",
    "annotations": {
      "metallb.io/loadBalancerIPs": "10.0.0.73",
      "homelab.tom-mendy.com/temporary": "Inter-cluster Pushgateway endpoint; remove after the Ubuntu scrape source is retired"
    }
  },
  "spec": {
    "type": "LoadBalancer",
    "externalTrafficPolicy": "Local",
    "selector": {
      "app": "pushgateway"
    },
    "ports": [
      {
        "name": "http",
        "port": 9091,
        "targetPort": 9091,
        "protocol": "TCP"
      }
    ]
  }
}
