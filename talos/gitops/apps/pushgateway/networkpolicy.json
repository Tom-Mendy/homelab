{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "pushgateway-ingress",
    "namespace": "pushgateway"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "pushgateway"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "ipBlock": {
              "cidr": "10.0.0.0/24"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.233.0.0/16"
            }
          },
          {
            "ipBlock": {
              "cidr": "10.244.0.0/16"
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 9091
          }
        ]
      }
    ]
  }
}
