{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "harbor-ubuntu-http-bridge",
    "namespace": "harbor",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "web"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [
      {
        "host": "harbor.home.tom-mendy.com",
        "http": {
          "paths": [
            {
              "path": "/api/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "harbor-core",
                  "port": {
                    "number": 80
                  }
                }
              }
            },
            {
              "path": "/service/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "harbor-core",
                  "port": {
                    "number": 80
                  }
                }
              }
            },
            {
              "path": "/v2/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "harbor-core",
                  "port": {
                    "number": 80
                  }
                }
              }
            },
            {
              "path": "/c/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "harbor-core",
                  "port": {
                    "number": 80
                  }
                }
              }
            },
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "harbor-portal",
                  "port": {
                    "number": 80
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
