{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "navidrome",
    "namespace": "navidrome"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "navidrome"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "navidrome"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "ND_MUSICFOLDER",
                "value": "/music"
              },
              {
                "name": "ND_DATAFOLDER",
                "value": "/data"
              }
            ],
            "image": "deluan/navidrome:0.64.2@sha256:38dc2727bfcfd5ede290f8ada114fc90368146f265ae4701ddddbcbe2a44ee52",
            "imagePullPolicy": "IfNotPresent",
            "name": "navidrome",
            "ports": [
              {
                "containerPort": 4533,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "500m",
                "memory": "1Gi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/music",
                "name": "music",
                "readOnly": true
              },
              {
                "mountPath": "/data",
                "name": "data"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "music",
            "persistentVolumeClaim": {
              "claimName": "navidrome-music-pvc"
            }
          },
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "navidrome-data-pvc"
            }
          }
        ]
      }
    }
  }
}
