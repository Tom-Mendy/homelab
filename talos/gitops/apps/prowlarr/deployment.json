{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "prowlarr",
    "namespace": "media"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "prowlarr"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": "25%"
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "prowlarr"
        }
      },
      "spec": {
        "containers": [
          {
            "env": [
              {
                "name": "PUID",
                "value": "1023"
              },
              {
                "name": "PGID",
                "value": "100"
              },
              {
                "name": "TZ",
                "value": "Europe/Paris"
              }
            ],
            "image": "lscr.io/linuxserver/prowlarr:2.6.5@sha256:f2b26429893d4c4cb71941b7ee50b1bdecd9d5f9f9e02d5410615e9f4f7c8d95",
            "imagePullPolicy": "IfNotPresent",
            "name": "prowlarr",
            "ports": [
              {
                "containerPort": 9696,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "resources": {},
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/config",
                "name": "config"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 30,
        "volumes": [
          {
            "name": "config",
            "persistentVolumeClaim": {
              "claimName": "prowlarr-config-pvc"
            }
          }
        ]
      }
    }
  }
}
