{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "talos-pushgateway-reconciler",
        "namespace": "flux-system"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "talos-pushgateway-reconciler",
        "namespace": "pushgateway"
      },
      "rules": [
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "services"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "networking.k8s.io"
          ],
          "resources": [
            "networkpolicies"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "serviceaccounts"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "replicasets"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "talos-pushgateway-reconciler",
        "namespace": "pushgateway"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "talos-pushgateway-reconciler"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "talos-pushgateway-reconciler",
          "namespace": "flux-system"
        }
      ]
    },
    {
      "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
      "kind": "Kustomization",
      "metadata": {
        "name": "pushgateway",
        "namespace": "flux-system"
      },
      "spec": {
        "interval": "5m",
        "retryInterval": "30s",
        "timeout": "3m",
        "sourceRef": {
          "kind": "GitRepository",
          "name": "talos-bootstrap"
        },
        "path": "./talos/gitops/apps/pushgateway",
        "serviceAccountName": "talos-pushgateway-reconciler",
        "prune": true,
        "healthChecks": [
          {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "name": "pushgateway",
            "namespace": "pushgateway"
          }
        ],
        "wait": true
      }
    }
  ]
}
