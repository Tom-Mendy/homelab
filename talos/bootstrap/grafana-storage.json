{
  "apiVersion": "v1",
  "kind": "PersistentVolume",
  "metadata": {
    "name": "grafana-static-pv"
  },
  "spec": {
    "capacity": {
      "storage": "5Gi"
    },
    "accessModes": [
      "ReadWriteOnce"
    ],
    "persistentVolumeReclaimPolicy": "Retain",
    "storageClassName": "nfs-k8s",
    "volumeMode": "Filesystem",
    "mountOptions": [
      "nfsvers=4.1"
    ],
    "nfs": {
      "server": "10.0.0.11",
      "path": "/volume1/k8s/grafana-grafana-pvc-2f17a00c-06b7-4e07-a189-d1b15b21078f",
      "readOnly": false
    }
  }
}
