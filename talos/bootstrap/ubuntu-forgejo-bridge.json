{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "forgejo-talos-bootstrap",
    "namespace": "forgejo",
    "annotations": {
      "metallb.io/loadBalancerIPs": "10.0.0.62",
      "homelab.tom-mendy.com/temporary": "Remove after Talos has an independent Git source"
    }
  },
  "spec": {
    "type": "LoadBalancer",
    "allocateLoadBalancerNodePorts": false,
    "externalTrafficPolicy": "Local",
    "selector": {
      "app": "forgejo"
    },
    "ports": [
      {
        "name": "ssh",
        "port": 22,
        "targetPort": 22,
        "protocol": "TCP"
      }
    ]
  }
}