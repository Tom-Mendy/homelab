{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ollama",
        "namespace": "ollama",
        "labels": {
          "app.kubernetes.io/instance": "ollama",
          "app.kubernetes.io/managed-by": "Helm",
          "app.kubernetes.io/name": "ollama",
          "helm.sh/chart": "ollama-local-0.1.1_4b00ce07c4c4",
          "helm.toolkit.fluxcd.io/name": "ollama",
          "helm.toolkit.fluxcd.io/namespace": "flux-system"
        }
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "ollama",
            "app.kubernetes.io/instance": "ollama",
            "app.kubernetes.io/name": "ollama"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "annotations": {
              "kubectl.kubernetes.io/restartedAt": "2026-04-11T00:02:07+09:00"
            },
            "labels": {
              "app": "ollama",
              "app.kubernetes.io/instance": "ollama",
              "app.kubernetes.io/name": "ollama"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "/bin/sh",
                  "-c",
                  "ollama serve"
                ],
                "env": [
                  {
                    "name": "OLLAMA_HOST",
                    "value": "0.0.0.0:11434"
                  },
                  {
                    "name": "OLLAMA_CONTEXT_LENGTH",
                    "value": "8192"
                  }
                ],
                "image": "ollama/ollama:0.40.13@sha256:b2f0122c476bc9fe7ce679d8bb4bd555351e25e2554eefb156f61cb0a89cf429",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/api/version",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "ollama",
                "ports": [
                  {
                    "containerPort": 11434,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/api/version",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "nvidia.com/gpu": "1"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/root/.ollama",
                    "name": "data"
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "nodeSelector": {
              "kubernetes.io/hostname": "node3"
            },
            "restartPolicy": "Always",
            "runtimeClassName": "nvidia",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30,
            "tolerations": [
              {
                "effect": "NoSchedule",
                "key": "nvidia.com/gpu",
                "operator": "Exists"
              },
              {
                "effect": "NoSchedule",
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists"
              },
              {
                "effect": "NoSchedule",
                "key": "node-role.kubernetes.io/master",
                "operator": "Exists"
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "ollama-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ollama",
        "namespace": "ollama",
        "labels": {
          "app.kubernetes.io/instance": "ollama",
          "app.kubernetes.io/managed-by": "Helm",
          "app.kubernetes.io/name": "ollama",
          "helm.sh/chart": "ollama-local-0.1.1_4b00ce07c4c4",
          "helm.toolkit.fluxcd.io/name": "ollama",
          "helm.toolkit.fluxcd.io/namespace": "flux-system"
        }
      },
      "spec": {
        "selector": {
          "app": "ollama",
          "app.kubernetes.io/instance": "ollama",
          "app.kubernetes.io/name": "ollama"
        },
        "ports": [
          {
            "name": "http",
            "port": 11434,
            "protocol": "TCP",
            "targetPort": "http"
          }
        ],
        "type": "ClusterIP"
      }
    }
  ],
  "kind": "List",
  "metadata": {
    "resourceVersion": ""
  }
