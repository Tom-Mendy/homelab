{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "secrets.infisical.com/v1beta1",
      "kind": "InfisicalConnection",
      "metadata": {
        "name": "searxng-infisical",
        "namespace": "searxng"
      },
      "spec": {
        "address": "https://infisical.home.tom-mendy.com"
      }
    },
    {
      "apiVersion": "secrets.infisical.com/v1beta1",
      "kind": "InfisicalAuth",
      "metadata": {
        "name": "searxng-infisical",
        "namespace": "searxng"
      },
      "spec": {
        "infisicalConnectionRef": {
          "name": "searxng-infisical",
          "namespace": "searxng"
        },
        "kubernetes": {
          "identityIdRef": {
            "key": "identityId",
            "name": "searxng-infisical-identity",
            "namespace": "searxng"
          },
          "serviceAccountRef": {
            "name": "searxng-infisical-sync",
            "namespace": "searxng"
          }
        },
        "method": "kubernetes"
      }
    },
    {
      "apiVersion": "secrets.infisical.com/v1beta1",
      "kind": "InfisicalStaticSecret",
      "metadata": {
        "name": "searxng-secrets",
        "namespace": "searxng"
      },
      "spec": {
        "infisicalAuthRef": {
          "name": "searxng-infisical",
          "namespace": "searxng"
        },
        "sources": [
          {
            "environmentSlug": "prod",
            "projectId": "758123bc-7eaa-4256-98a2-bb7438a783b8",
            "recursive": false,
            "secretPath": "/searxng"
          }
        ],
        "syncOptions": {
          "instantUpdates": false,
          "refreshInterval": "1m"
        },
        "targets": [
          {
            "creationPolicy": "Orphan",
            "kind": "Secret",
            "name": "searxng-secret",
            "namespace": "searxng",
            "secretType": "Opaque",
            "template": {
              "data": {
                "server-secret-key": "{{ index . \"server-secret-key\" }}"
              },
              "engineVersion": "v1"
            }
          },
          {
            "creationPolicy": "Orphan",
            "kind": "Secret",
            "name": "searxng-nymvpn-credentials",
            "namespace": "searxng",
            "secretType": "Opaque",
            "template": {
              "data": {
                "NYM_ACCESS_CODE": "{{ .NYM_ACCESS_CODE.Value }}"
              },
              "engineVersion": "v1"
            }
          }
        ]
      }
    }
  ]
}
