{
  "apiVersion": "traefik.io/v1alpha1",
  "kind": "IngressRouteTCP",
  "metadata": {
    "name": "forgejo-ssh-ingress",
    "namespace": "forgejo",
    "annotations": {
      "kubernetes.io/ingress.class": "talos-traefik"
    }
  },
  "spec": {
    "entryPoints": [
      "forgejo-ssh"
    ],
    "routes": [
      {
        "match": "HostSNI(`*`)",
        "services": [
          {
            "name": "forgejo",
            "port": 22
          }
        ]
      }
    ]
  }
}
