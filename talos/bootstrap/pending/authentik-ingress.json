{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "traefik.io/v1alpha1",
      "kind": "Middleware",
      "metadata": {
        "name": "authentik-public-https",
        "namespace": "authentik"
      },
      "spec": {
        "headers": {
          "customRequestHeaders": {
            "X-Forwarded-Proto": "https",
            "X-Forwarded-Port": "443"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "authentik-server",
        "namespace": "authentik",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "web",
          "traefik.ingress.kubernetes.io/router.priority": "150",
          "traefik.ingress.kubernetes.io/router.middlewares": "authentik-authentik-public-https@kubernetescrd"
        }
      },
      "spec": {
        "ingressClassName": "talos-traefik",
        "rules": [
          {
            "host": "authentik.tom-mendy.com",
            "http": {
              "paths": [
                {
                  "backend": {
                    "service": {
                      "name": "authentik-server",
                      "port": {
                        "number": 80
                      }
                    }
                  },
                  "path": "/",
                  "pathType": "Prefix"
                }
              ]
            }
          }
        ]
      }
    },
