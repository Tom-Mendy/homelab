{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "coder-direct-https",
    "namespace": "coder",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [
      {
        "host": "coder.tom-mendy.com",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "coder",
                  "port": {
                    "name": "http"
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      }
    ],
    "tls": [
      {
        "hosts": [
          "coder.tom-mendy.com"
        ],
        "secretName": "coder-direct-tls"
      }
    ]
  }
}
