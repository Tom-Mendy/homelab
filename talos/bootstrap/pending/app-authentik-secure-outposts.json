{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "qbittorrent-authentik-outpost-secure",
        "namespace": "authentik",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.middlewares": "authentik-authentik-public-https@kubernetescrd",
          "traefik.ingress.kubernetes.io/router.priority": "150"
        }
      },
      "spec": {
        "ingressClassName": "talos-traefik",
        "rules": [
          {
            "host": "torrent.tom-mendy.com",
            "http": {
              "paths": [
                {
                  "backend": {
                    "service": {
                      "name": "authentik-server",
                      "port": {
                        "number": 80
                      }
                    }
                  },
                  "path": "/outpost.goauthentik.io",
                  "pathType": "Prefix"
                }
              ]
            }
          }
        ],
        "tls": [
          {
            "hosts": [
              "torrent.tom-mendy.com"
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "job-search-manager-authentik-outpost-secure",
        "namespace": "authentik",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.middlewares": "authentik-authentik-public-https@kubernetescrd",
          "traefik.ingress.kubernetes.io/router.priority": "150"
        }
      },
      "spec": {
        "ingressClassName": "talos-traefik",
        "rules": [
          {
            "host": "suivi-stage.home.tom-mendy.com",
            "http": {
              "paths": [
                {
                  "backend": {
                    "service": {
                      "name": "authentik-server",
                      "port": {
                        "number": 80
                      }
                    }
                  },
                  "path": "/outpost.goauthentik.io",
                  "pathType": "Prefix"
                }
              ]
            }
          }
        ],
        "tls": [
          {
            "hosts": [
              "suivi-stage.home.tom-mendy.com"
            ]
          }
        ]
      }
    }
  ]
}
