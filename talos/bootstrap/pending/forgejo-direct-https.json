{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "forgejo-direct-https",
    "namespace": "forgejo",
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
      "traefik.ingress.kubernetes.io/router.middlewares": "forgejo-forgejo-public-https@kubernetescrd"
    }
  },
  "spec": {
    "ingressClassName": "talos-traefik",
    "rules": [
      {
        "host": "forgejo.tom-mendy.com",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "forgejo",
                  "port": {
                    "number": 3000
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      },
      {
        "host": "forgejo.home.tom-mendy.com",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "forgejo",
                  "port": {
                    "number": 3000
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      }
    ],
    "tls": [
      {
        "hosts": [
          "forgejo.tom-mendy.com"
        ],
        "secretName": "forgejo-direct-tls"
      },
      {
        "hosts": [
          "forgejo.home.tom-mendy.com"
        ],
        "secretName": "forgejo-home-direct-tls"
      }
    ]
  }
}
