{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "infisical"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "talos-infisical-reviewer",
        "namespace": "infisical"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "talos-infisical-token-reviewer"
      },
      "rules": [
        {
          "apiGroups": [
            "authentication.k8s.io"
          ],
          "resources": [
            "tokenreviews"
          ],
          "verbs": [
            "create"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "talos-infisical-token-reviewer"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "talos-infisical-token-reviewer"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "talos-infisical-reviewer",
          "namespace": "infisical"
        }
      ]
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "talos-infisical-reviewer-token",
        "namespace": "infisical",
        "annotations": {
          "kubernetes.io/service-account.name": "talos-infisical-reviewer"
        }
      },
      "type": "kubernetes.io/service-account-token"
    }
  ]
}
