{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespace", "ingress"],
  "additionalProperties": true,
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "ingress": {
      "type": "object",
      "required": [
        "name",
        "host",
        "className",
        "serviceName",
        "servicePort",
        "annotations"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1
        },
        "servicePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
