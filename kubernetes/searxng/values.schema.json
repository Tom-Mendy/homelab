{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "createNamespace", "replicaCount", "image", "service", "ingress", "env", "secret", "nymVpn", "infisicalSecret"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "createNamespace": { "type": "boolean" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "deploymentAnnotations": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "className", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceName", "baseUrl", "autocomplete"],
      "properties": {
        "instanceName": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "minLength": 1 },
        "autocomplete": { "type": "string", "minLength": 1 }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "create", "serverSecretKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "create": { "type": "boolean" },
        "serverSecretKey": { "type": "string" }
      }
    },
    "nymVpn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "pullPolicy",
        "secretName",
        "entryCountry",
        "exitCountry",
        "podCidr",
        "stateStorage"
      ],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "secretName": { "type": "string", "minLength": 1 },
        "entryCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "exitCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "podCidr": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" },
        "stateStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className", "size"],
          "properties": {
            "className": { "type": "string", "const": "nfs-k8s" },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "infisicalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "serviceAccountName",
        "connectionName",
        "authName",
        "identitySecretName",
        "address",
        "identityID",
        "projectId",
        "envSlug",
        "secretsPath"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "connectionName": { "type": "string", "minLength": 1 },
        "authName": { "type": "string", "minLength": 1 },
        "identitySecretName": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "identityID": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "envSlug": { "type": "string", "minLength": 1 },
        "secretsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
