{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "oidc", "cluster", "outpostIngresses", "authentik"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprintConfigMapName", "infisical"],
      "properties": {
        "blueprintConfigMapName": { "type": "string", "minLength": 1 },
        "infisical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionName",
            "authName",
            "identitySecretName",
            "identityID",
            "secretName",
            "address",
            "projectId",
            "envSlug"
          ],
          "properties": {
            "connectionName": { "type": "string", "minLength": 1 },
            "authName": { "type": "string", "minLength": 1 },
            "identitySecretName": { "type": "string", "minLength": 1 },
            "identityID": { "type": "string", "minLength": 1 },
            "secretName": { "type": "string", "minLength": 1 },
            "address": { "type": "string", "minLength": 1 },
            "projectId": { "type": "string", "minLength": 1 },
            "envSlug": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "instances", "imageName", "storage", "database", "owner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "instances": { "type": "integer", "minimum": 1 },
        "imageName": { "type": "string", "minLength": 1 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "storageClass"],
          "properties": {
            "size": { "type": "string", "minLength": 1 },
            "storageClass": { "type": "string", "minLength": 1 }
          }
        },
        "database": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "outpostIngresses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "host": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authentik": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
