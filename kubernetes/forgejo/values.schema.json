{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "createNamespace", "replicaCount", "image", "user", "rootUrl", "database", "oauth2Client", "oidc", "actions", "service", "ingress", "storage"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "createNamespace": { "type": "boolean" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "deploymentAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "gid"],
      "properties": {
        "uid": { "type": "string", "minLength": 1 },
        "gid": { "type": "string", "minLength": 1 }
      }
    },
    "rootUrl": { "type": "string", "minLength": 1 },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "host", "name", "sslMode", "secretName"],
      "properties": {
        "type": { "type": "string", "enum": ["sqlite3", "postgres"] },
        "host": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sslMode": { "type": "string", "minLength": 1 },
        "secretName": { "type": "string", "minLength": 1 }
      }
    },
    "oauth2Client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enableAutoRegistration", "username"],
      "properties": {
        "enableAutoRegistration": { "type": "boolean" },
        "username": { "type": "string", "enum": ["userid", "nickname", "email"] }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 }
      }
    },
    "actions": {
      "type": "object",
      "required": ["enabled", "defaultActionsUrl"],
      "properties": {
        "enabled": { "type": "string", "enum": ["true", "false"] },
        "defaultActionsUrl": { "type": "string", "minLength": 1 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "httpPort", "sshPort"],
      "properties": {
        "type": { "type": "string" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "aliases", "className", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sshIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "entryPoint"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entryPoint": { "type": "string", "minLength": 1 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pvName", "pvcName", "size", "nfsServer", "nfsPath"],
      "properties": {
        "pvName": { "type": "string", "minLength": 1 },
        "pvcName": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 },
        "nfsServer": { "type": "string", "minLength": 1 },
        "nfsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
