{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "createNamespace", "replicaCount", "image", "user", "rootUrl", "service", "ingress", "storage"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "createNamespace": { "type": "boolean" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "deploymentAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "gid"],
      "properties": {
        "uid": { "type": "string", "minLength": 1 },
        "gid": { "type": "string", "minLength": 1 }
      }
    },
    "rootUrl": { "type": "string", "minLength": 1 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "httpPort", "sshPort"],
      "properties": {
        "type": { "type": "string" },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "className", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "sshIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "entryPoint"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entryPoint": { "type": "string", "minLength": 1 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pvName", "pvcName", "size", "nfsServer", "nfsPath"],
      "properties": {
        "pvName": { "type": "string", "minLength": 1 },
        "pvcName": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "minLength": 1 },
        "nfsServer": { "type": "string", "minLength": 1 },
        "nfsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
