      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace,pod,container) (container_memory_working_set_bytes{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"})",
          "legendFormat": "Working set · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "max by (namespace,pod,container) (kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\",resource=\"memory\"})",
          "legendFormat": "Request · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        },
        {
          "refId": "C",
          "expr": "max by (namespace,pod,container) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\",resource=\"memory\"}) > 0",
          "legendFormat": "Limit · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Top 10 containers · CPU cores",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current CPU rate, ranked within the selected filters.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__rate_interval])) and on (namespace,pod,container) max by (namespace,pod,container) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}))",
          "legendFormat": "{{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": false
      }
    },
