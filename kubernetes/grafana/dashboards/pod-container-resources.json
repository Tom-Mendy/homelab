{
  "uid": "pod-container-resources",
  "title": "Pod & Container Resources",
  "description": "Pod and container resource usage from kubelet cAdvisor and kube-state-metrics, with requests, limits and throttling.",
  "tags": [
    "kubernetes",
    "containers",
    "cadvisor",
    "resources"
  ],
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1,
        "options": []
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_node_info,node)",
        "query": {
          "query": "label_values(kube_node_info,node)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_container_info{node=~\"$node\"},namespace)",
        "query": {
          "query": "label_values(kube_pod_container_info{node=~\"$node\"},namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_container_info{node=~\"$node\",namespace=~\"$namespace\"},pod)",
        "query": {
          "query": "label_values(kube_pod_container_info{node=~\"$node\",namespace=~\"$namespace\"},pod)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_container_info{node=~\"$node\",namespace=~\"$namespace\",pod=~\"$pod\"},container)",
        "query": {
          "query": "label_values(kube_pod_container_info{node=~\"$node\",namespace=~\"$namespace\",pod=~\"$pod\"},container)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Kubernetes Cluster",
      "type": "link",
      "url": "/d/k8s-cluster",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU in use · cores",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "1.0 means one CPU core. CPU usage may exceed a request when spare capacity is available.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__rate_interval])) and on (namespace,pod,container) max by (namespace,pod,container) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}))",
          "legendFormat": "CPU cores",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Memory working set",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Active containers only. Working set includes RSS and non-reclaimable cache; it is not the same as RSS.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace,pod,container) (container_memory_working_set_bytes{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}) and on (namespace,pod,container) max by (namespace,pod,container) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}))",
          "legendFormat": "Working set",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Running containers",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace,pod,container) (kube_pod_container_status_running{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}))",
          "legendFormat": "Containers",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Container restarts · selected time range",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Counter increase across the selected time range. Prometheus extrapolation can yield fractional estimates.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (namespace,pod,container) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__range])))",
          "legendFormat": "Restarts",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": false,
          "instant": true,
          "interval": "1m"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Container CPU · usage, requests and limits",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Values are CPU cores, not percent. Dashed lines show configured requests and limits. A missing limit line means no CPU limit is configured.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Request|Limit) ·"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace,pod,container) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "Usage · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "max by (namespace,pod,container) (kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\",resource=\"cpu\"})",
          "legendFormat": "Request · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        },
        {
          "refId": "C",
          "expr": "max by (namespace,pod,container) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\",resource=\"cpu\"}) > 0",
          "legendFormat": "Limit · {{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Container memory · usage, requests and limits",
