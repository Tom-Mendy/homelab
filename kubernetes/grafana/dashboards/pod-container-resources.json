    {
      "id": 9,
      "title": "CPU throttled periods",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Percentage of CPU scheduling periods in which the container was throttled, not percentage of CPU time lost. Unlimited containers may have no series.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (max by (namespace,pod,container) (rate(container_cpu_cfs_throttled_periods_total{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__rate_interval]))) / (max by (namespace,pod,container) (rate(container_cpu_cfs_periods_total{job=\"kubernetes-nodes-cadvisor\",container!=\"\",container!=\"POD\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",node=~\"$node\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{namespace}} / {{pod}} / {{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "instant": false,
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Memory working set / configured limit",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Only containers with a positive memory limit are shown. No data for an unlimited container is expected.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
