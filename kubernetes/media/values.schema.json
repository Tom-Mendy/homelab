{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "timezone", "securityContext", "nymVpn", "storage", "configStorage", "ingress", "apps", "infisicalSecret"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["puid", "pgid"],
      "properties": {
        "puid": { "type": "integer", "minimum": 1 },
        "pgid": { "type": "integer", "minimum": 1 }
      }
    },
    "nymVpn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "pullPolicy", "secretName", "entryCountry", "exitCountry", "podCidr", "stateStorage"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "secretName": { "type": "string", "minLength": 1 },
        "entryCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "exitCountry": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "podCidr": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" },
        "stateStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className", "size"],
          "properties": {
            "className": { "type": "string", "const": "nfs-k8s" },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nfsServer", "downloads", "movies", "series"],
      "properties": {
        "nfsServer": { "type": "string", "minLength": 1 },
        "downloads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "size"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "movies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "size"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "series": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "size"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "configStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "defaultSize"],
      "properties": {
        "className": { "type": "string", "minLength": 1 },
        "defaultSize": { "type": "string", "minLength": 1 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "port", "host", "vpn", "mounts"],
        "properties": {
          "image": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "host": { "type": "string", "minLength": 1 },
          "vpn": { "type": "boolean" },
          "mounts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["downloads", "movies", "series"],
            "properties": {
              "downloads": { "type": "boolean" },
              "movies": { "type": "boolean" },
              "series": { "type": "boolean" }
            }
          },
          "extraEnv": { "type": "object", "additionalProperties": { "type": "string" } },
          "ssoAuthWhitelist": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" },
          "configSize": { "type": "string" }
        }
      }
    },
    "infisicalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "serviceAccountName",
        "connectionName",
        "authName",
        "identitySecretName",
        "address",
        "identityID",
        "projectId",
        "envSlug",
        "secretsPath"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "connectionName": { "type": "string", "minLength": 1 },
        "authName": { "type": "string", "minLength": 1 },
        "identitySecretName": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "identityID": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "envSlug": { "type": "string", "minLength": 1 },
        "secretsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
