{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "secret", "infisicalSecret"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "create", "apiToken"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "create": { "type": "boolean" },
        "apiToken": { "type": "string" }
      }
    },
    "infisicalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "serviceAccountName",
        "hostAPI",
        "identityID",
        "projectSlug",
        "envSlug",
        "secretsPath"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "hostAPI": { "type": "string", "minLength": 1 },
        "identityID": { "type": "string" },
        "projectSlug": { "type": "string", "minLength": 1 },
        "envSlug": { "type": "string", "minLength": 1 },
        "secretsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
