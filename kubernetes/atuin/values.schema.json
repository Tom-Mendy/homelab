{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "namespace": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nfsPermissions": {
      "type": "object",
      "properties": {
        "userUid": { "type": "string" },
        "userGid": { "type": "string" }
      },
      "required": ["userUid", "userGid"]
    },
    "atuin": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "required": ["repository", "tag", "pullPolicy"]
        },
        "host": { "type": "string" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "openRegistration": { "type": "boolean" },
        "db": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "user": { "type": "string" },
            "password": { "type": "string" }
          },
          "required": ["name", "user", "password"]
        },
        "storage": {
          "type": "object",
          "properties": {
            "pvName": { "type": "string" },
            "pvcName": { "type": "string" },
            "size": { "type": "string" },
            "accessMode": { "type": "string" },
            "reclaimPolicy": { "type": "string" },
            "storageClassName": { "type": "string" },
            "nfsServer": { "type": "string" },
            "nfsPath": { "type": "string" }
          },
          "required": ["pvcName", "size", "accessMode", "storageClassName"]
        }
      },
      "required": ["image", "host", "port", "openRegistration", "db", "storage"]
    },
    "postgres": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          },
          "required": ["repository", "tag", "pullPolicy"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "storage": {
          "type": "object",
          "properties": {
            "pvName": { "type": "string" },
            "pvcName": { "type": "string" },
            "size": { "type": "string" },
            "accessMode": { "type": "string" },
            "reclaimPolicy": { "type": "string" },
            "storageClassName": { "type": "string" },
            "nfsServer": { "type": "string" },
            "nfsPath": { "type": "string" }
          },
          "required": ["pvcName", "size", "accessMode", "storageClassName"]
        }
      },
      "required": ["image", "port", "storage"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" }
      },
      "required": ["type"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["enabled", "className", "annotations"]
    },
    "infisicalSecret": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "serviceAccountName": { "type": "string" },
        "connectionName": { "type": "string" },
        "authName": { "type": "string" },
        "identitySecretName": { "type": "string" },
        "address": { "type": "string" },
        "identityID": { "type": "string" },
        "projectId": { "type": "string" },
        "envSlug": { "type": "string" },
        "secretsPath": { "type": "string" }
      },
      "required": [
        "enabled",
        "name",
        "serviceAccountName",
        "connectionName",
        "authName",
        "identitySecretName",
        "address",
        "identityID",
        "projectId",
        "envSlug",
        "secretsPath"
      ]
    }
  },
  "required": ["namespace", "replicaCount", "nfsPermissions", "atuin", "postgres", "service", "ingress", "infisicalSecret"]
}
