{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": ["namespace", "secret", "infisicalSecret"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "infisicalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "serviceAccountName",
        "connectionName",
        "authName",
        "identitySecretName",
        "address",
        "identityID",
        "projectId",
        "envSlug",
        "secretsPath"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "connectionName": { "type": "string", "minLength": 1 },
        "authName": { "type": "string", "minLength": 1 },
        "identitySecretName": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "identityID": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "envSlug": { "type": "string", "minLength": 1 },
        "secretsPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
